---
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
  /** Home-page form: drops the author list and the note. */
  compact?: boolean;
}

const { publication: pub, compact = false } = Astro.props;

const authors = pub.authors.map((name) =>
  /(^|\s)Ahmed\b/.test(name) && /Zahran$/.test(name) ? { name, self: true } : { name, self: false },
);
---

<article class="pub">
  <p class="venue meta">{pub.venue}</p>

  <div class="body">
    <h3 class="title">
      <a href={pub.href} class="link">{pub.title}</a>
    </h3>

    {
      !compact && (
        <p class="authors">
          {authors.map((author, i) => (
            <>
              {i > 0 && ', '}
              <span class:list={['author', { self: author.self }]}>{author.name}</span>
            </>
          ))}
        </p>
      )
    }

    <p class="detail meta">{pub.detail}</p>

    {!compact && <p class="note">{pub.note}</p>}

    {
      pub.code && (
        <p class="code">
          <a href={pub.code} class="link">
            Code on GitHub ↗
          </a>
        </p>
      )
    }
  </div>
</article>

<style>
  .pub {
    display: grid;
    gap: 0.35rem 2.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .venue {
    white-space: nowrap;
    color: var(--accent);
    padding-block-start: 0.3rem;
  }

  .title {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    max-width: 42rem;
  }

  .authors {
    margin-block-start: 0.55rem;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 42rem;
  }

  .author.self {
    color: var(--text);
    font-weight: 600;
  }

  .detail {
    margin-block-start: 0.25rem;
  }

  .note {
    margin-block-start: 0.75rem;
    max-width: 40rem;
  }

  .code {
    margin-block-start: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (min-width: 46rem) {
    .pub {
      grid-template-columns: 10rem 1fr;
    }
  }
</style>
