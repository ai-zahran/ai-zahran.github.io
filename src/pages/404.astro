---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../data/site';
---

<BaseLayout title="Page not found" description="That page doesn’t exist on this site.">
  <section class="shell wrap">
    <p class="eyebrow">404</p>
    <h1 class="page-title">No signal here</h1>
    <p class="lede measure">
      That page doesn’t exist. If you followed a link to an old post, the archive moved to
      <a href="/blog/" class="link">/blog</a> — the post is probably still there under a shorter
      address.
    </p>
    <ul class="routes">
      <li><a href="/" class="link">Home</a></li>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  .eyebrow {
    display: block;
    margin-block-end: 0.75rem;
    color: var(--signal);
  }

  .page-title {
    margin-block-end: 1.25rem;
  }

  .routes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-block-start: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
</style>
