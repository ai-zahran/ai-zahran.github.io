---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { publications, education } from '../data/publications';
---

<BaseLayout
  title="Research"
  description="Peer-reviewed work on hallucination detection through knowledge graph alignment, end-to-end pronunciation scoring, and Arabic dialect identification."
>
  <section class="shell head">
    <p class="eyebrow">Research</p>
    <h1 class="page-title">Papers and degrees</h1>
    <p class="lede measure">
      Three peer-reviewed papers: two on Arabic speech — dialect identification, then pronunciation
      scoring, which became my M.Sc. thesis — and one on catching hallucinations by aligning what a
      model says against a knowledge graph.
    </p>
  </section>

  <section class="shell pubs">
    {publications.map((publication) => <PublicationItem publication={publication} />)}
  </section>

  <section class="shell section">
    <h2 class="section-title">Education</h2>
    <div class="degrees">
      {
        education.map((entry) => (
          <article class="degree">
            <p class="when meta">{entry.date}</p>
            <div>
              <h3 class="degree-title">{entry.degree}</h3>
              <p class="institution">{entry.institution}</p>
              <ul class="points">
                {entry.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 1.5rem;
  }

  .head .eyebrow {
    display: block;
    margin-block-end: 0.75rem;
  }

  .page-title {
    margin-block-end: 1.25rem;
  }

  .pubs {
    padding-block-end: 1rem;
  }

  .pubs :global(.pub:first-child) {
    border-top-color: var(--accent);
  }

  .degrees {
    margin-block-start: 2rem;
  }

  .degree {
    display: grid;
    gap: 0.35rem 2.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .when {
    white-space: nowrap;
    padding-block-start: 0.3rem;
    color: var(--accent);
  }

  .degree-title {
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .institution {
    color: var(--muted);
    margin-block-start: 0.2rem;
  }

  .points {
    list-style: none;
    margin-block-start: 0.9rem;
    max-width: 44rem;
  }

  .points li {
    position: relative;
    padding-inline-start: 1.1rem;
  }

  .points li + li {
    margin-block-start: 0.5rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.72em;
    width: 0.3rem;
    height: 1px;
    background: var(--accent);
  }

  @media (min-width: 46rem) {
    .degree {
      grid-template-columns: 10rem 1fr;
    }
  }
</style>
