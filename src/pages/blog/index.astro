---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout
  title="Writing"
  description="Ramblings about AI, speech and language — how the systems work, what breaks in practice, and the occasional detour into history."
>
  <section class="shell head">
    <p class="eyebrow">Writing</p>
    <h1 class="page-title">Notes from the work</h1>
    <p class="lede measure">
      Ramblings about AI, speech, and language: how the systems actually work, what breaks once
      they meet real data, and the occasional detour into how we got here. Written while figuring
      things out, so some of it is a lab notebook and some of it is an argument.
    </p>
    <p class="feed meta">
      <a href="/rss.xml" class="link">Subscribe via RSS</a>
    </p>
  </section>

  <section class="shell posts">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 1.5rem;
  }

  .head .eyebrow {
    display: block;
    margin-block-end: 0.75rem;
  }

  .page-title {
    margin-block-end: 1.25rem;
  }

  .feed {
    margin-block-start: 1.5rem;
  }

  .posts {
    padding-block-end: clamp(3rem, 6vw, 5rem);
  }

  .posts :global(.post:first-child) {
    border-top-color: var(--accent);
  }

  .posts :global(.post:last-child) {
    border-bottom: 1px solid var(--rule);
  }
</style>
